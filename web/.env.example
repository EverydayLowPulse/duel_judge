# カード／Q&A／ルールキャッシュの置き場（任意）
# ローカル未設定時: リポジトリの ../data
# Vercel 未設定時: /tmp/duel_judge_data（エフェメラル）
# DUEL_JUDGE_DATA=

# Google AI Studio（無料枠があるうちはこちらを優先）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 無料枠モデル例: gemini-3.5-flash / gemini-3-flash-preview / gemini-2.5-flash
# 混雑時は 503 になることがあるので別モデルへ切替
GEMINI_MODEL=gemini-3-flash-preview

# LLM 切替: auto | gemini | deepseek（サーバ既定。UI からも上書き可）
# auto = Gemini優先。429/503/quota・混雑時は DeepSeek へフォールバック
LLM_PROVIDER=auto

# DeepSeek（有料・コスパ優先のフォールバック／カード名検索語の任意整形）
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# V4.1 Flash（裏: DeepSeek-V4.1-Flash-1017）。旧 ID の deepseek-v4-flash も同じモデルに転送される
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 公式検索0件時に dmwiki で正式名候補を取る（論拠には使わない）
# auto|on|off（既定 auto）
CARD_RESOLVE_WEB=auto
