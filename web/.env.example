# Google AI Studio（無料枠があるうちはこちらを優先）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 無料枠モデル例: gemini-3.5-flash / gemini-3-flash-preview / gemini-2.5-flash
# 混雑時は 503 になることがあるので別モデルへ切替
GEMINI_MODEL=gemini-3-flash-preview

# LLM 切替: auto | gemini | deepseek
# auto = Gemini優先。429/quota なら DeepSeek へフォールバック
LLM_PROVIDER=auto

# DeepSeek（有料・コスパ優先のフォールバック）
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
